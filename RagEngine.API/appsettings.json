{
  "AllowedHosts": "*",
  "Chunking": {
    "MaxTokensPerLine": 100,
    "MaxTokensPerParagraph": 300,
    "OverlapTokens": 30
  },
  "CosmosDb": {
    "EndpointUri": "https://raglab-db.documents.azure.com:443/",
    "DatabaseName": "raglab",
    "ContainerName": "chunks"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "qwen3-embedding:0.6b",
    "EmbeddingEndpoint": "/api/embed",
    "EmbeddingDimensions": 1024,
    "GenerationModel": "qwen3:4b",
    "GenerationEndpoint": "/api/generate"
  }
}
