{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "EmbeddingModel": "qwen3-embedding:0.6b",
        "EmbeddingEndpoint": "/api/embed",
        "EmbeddingDimensions": 1024
    },
    "Chunking": {
        "MaxTokensPerLine": 100,
        "MaxTokensPerParagraph": 300,
        "OverlapTokens": 30
    },
    "CosmosDb": {
        "Endpoint": "https://raglab-cosmos.documents.azure.com:443/", //TODO: Replace with Cosmos DB endpoint
        "DatabaseName": "raglab",
        "ContainerName": "chunks"
    }

}
